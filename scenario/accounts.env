# The scenario's identities — RD-2 HX-2 ("from eight accounts").
#
# DETERMINISTIC PRIVATE-NETWORK KEYS ONLY. These are the well-known accounts of
# the `test test … junk` mnemonic, the same set the framework's `ci-args.yaml`
# draws its poster and proof-signer keys from and the same set its generated L2
# genesis funds. Never use them on a public network or fund them with real
# assets.
#
# One file, two readers: `scenario/ops/*.sh` source it for the keys they sign
# with, and `scenario/lib/accounts.ts` parses it for the addresses the fixtures
# and assertions expect. A trader list that disagreed between the two would
# make the recorded run describe orders the enclave never placed.
#
# Accounts 0 and 1 are the framework's (poster, proof signer) and are
# deliberately absent: the DEX never signs with them.

# --- the eight traders (A.6's happy path) ------------------------------------
DEX_TRADER_COUNT=8

DEX_TRADER_0_ADDRESS=0x3c44cdddb6a900fa2b585dd299e03d12fa4293bc
DEX_TRADER_0_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
DEX_TRADER_1_ADDRESS=0x90f79bf6eb2c4f870365e785982e1f101e93b906
DEX_TRADER_1_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
DEX_TRADER_2_ADDRESS=0x15d34aaf54267db7d7c367839aaf71a00a2c6a65
DEX_TRADER_2_KEY=0x47e179ec197488593b187f80a00eb0da91f1b9d0b13f8733639f19c30a34926a
DEX_TRADER_3_ADDRESS=0x9965507d1a55bcc2695c58ba16fb37d819b0a4dc
DEX_TRADER_3_KEY=0x8b3a350cf5c34c9194ca85829a2df0ec3153be0318b5e2d3348e872092edffba
DEX_TRADER_4_ADDRESS=0x976ea74026e726554db657fa54763abd0c3a0aa9
