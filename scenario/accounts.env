# --- the DEX's own roles -----------------------------------------------------
# The deployer's L2 nonce is load-bearing: the L1 bundle predicts
# `DexBridgeL2` and `WindowBook`'s addresses from it before the L2 chain
# exists, so nothing else may sign from this account (HX-1).
DEX_DEPLOYER_ADDRESS=0xbcd4042de499d14e55001ccbb24a551f3b954096
DEX_DEPLOYER_KEY=0xf214f2b2cd398c806f84e317254e0f0b801d0643303237d97a22a48e01628897

# The settler key (A.5 `SETTLER_KEY`). Liveness and fairness only: it can never
# fill anyone at a price the L1 leg did not achieve (CT-10, EC-4).
DEX_SETTLER_ADDRESS=0x71be63f3384f5fb98995898a86b02fb2426c5788
DEX_SETTLER_KEY=0x701b615bbdfb9de65240bc28bd21bbc0d996645a3dd57e7b12bc2bdf6f192c82

# Bridge governance and guardian (EC-4). One account on the devnet; a multisig
# behind a timelock anywhere value is real.
DEX_GOVERNANCE_ADDRESS=0xfabb0ac9d68b0b445fb7357272ff202c5651694a
DEX_GOVERNANCE_KEY=0xa267530f49f8280200edf313ee7af6b827f2a8bce2897751d06a843f644967b1
